# ==============================================================================
# StayNearby Environment Variables (.env.example)
#
# IMPORTANT SECURITY WARNING:
# These default settings are designed for LOCAL DEVELOPMENT and DEMONSTRATION ONLY.
# In any staging or production deployment:
#  1. Generate a cryptographically secure random SECRET_KEY (e.g., using `openssl rand -hex 32`).
#  2. Use an enterprise-grade database (e.g., PostgreSQL with SSL: postgresql+psycopg2://user:pass@host:5432/db).
#  3. Restrict CORS_ORIGINS strictly to your production domain(s).
#  4. Set ENVIRONMENT=production to enforce HTTPS, cookie security, and hardened logging.
# ==============================================================================

# Application Environment (development | testing | production)
ENVIRONMENT=development

# JWT Secret Key (MUST BE CHANGED IN PRODUCTION)
SECRET_KEY=staynearby_super_secret_development_jwt_key_2026_change_in_prod

# JWT Algorithm
ALGORITHM=HS256

# JWT Access Token Expiry in Minutes (1440 mins = 24 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Connection URL (SQLite default for zero-setup local dev)
DATABASE_URL=sqlite:///./staynearby.db

# MLflow Experiment Tracking Database URI (Local SQLite backend store)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# Model Artifacts Directory
ARTIFACTS_DIR=backend/artifacts

# Allowed CORS Origins (JSON array of allowed browser origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
